LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_MS=20000
LLM_MAX_TOKENS=1500

# Fallback LLM Provider (Gemini via OpenAI-compatible endpoint)
# Defaults:
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# If unset, models are auto-discovered from Gemini (e.g. gemini-2.5-flash)
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=

GITHUB_TOKEN=